# 漫画下载管理器环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 漫画网站账号（必填）
MANGA_USERNAME=your_username
MANGA_PASSWORD=your_password

# 发布页地址
PUBLISH_PAGE_URL=https://wn01.link

# 数据库配置（可选。默认 SQLite，无需设置）
# Docker环境默认: sqlite:////app/data/manga.db（compose 已通过 volume 持久化）
# 如需 PostgreSQL: DATABASE_URL=postgresql://manga_user:manga_pass@db:5432/manga_db
#DATABASE_URL=

# 一括下载（详情页「下載漫畫」按钮 → 直接下载ZIP）。默认启用；
# 设为 false 则只使用传统的逐页下载方式
#ARCHIVE_DOWNLOAD_ENABLED=true

# 下载目录（Docker环境）
DOWNLOAD_DIR=/app/downloads
COVER_DIR=/app/covers

# API配置
API_HOST=0.0.0.0
API_PORT=8000

# CORS配置（JSON数组格式）
# 方案B 下前端与 API 同源，一般无需额外来源；如需跨域调试可在此追加。
CORS_ORIGINS=["http://localhost:18000"]

# 最近更新搜索时排除的分类/作者名（JSON数组格式或逗号分隔）
EXCLUDED_CATEGORIES=["优秀","全部","管理分類","書架","书架","我的書架","一般","真人","同人"]

# Docker 应用对外端口（前端 + API 同源配信，可选）
BACKEND_PORT=18000
